{
  "name": "subsidieready",
  "version": "1.0.0",
  "private": true,
  "description": "Gratis ISDE-documentenwerkbank voor eigenaar-bewoners. Lokaal, zonder account.",
  "scripts": {
    "dev": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build-site.cjs && node scripts/next/build.cjs && node scripts/build.cjs",
    "test:server": "node --test tests/server.test.cjs",
    "package": "node scripts/package.cjs",
    "preview:next": "node scripts/next/offline.cjs",
    "test:next": "node --test tests/next-*.test.cjs",
    "audit:seo": "node scripts/audit-seo.cjs",
    "audit:seo:live": "node scripts/audit-seo.cjs --live",
    "check:lead-pilot": "node scripts/lead-pilot.cjs --check"
  },
  "engines": {
    "node": ">=20"
  }
}
