# SubsidieReady: Apache/LiteSpeed, no secrets inside the webroot.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:server|scripts|tests|templates|docs|concept)(?:/|$) - [F,L]
RewriteRule ^(?:AGENTS\.md|README\.md|package(?:-lock)?\.json|composer\.(?:json|lock)|release-patch\.json|materialize-release\.cjs)$ - [F,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?subsidieready\.nl$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.subsidieready\.nl$ [NC]
RewriteRule ^ https://subsidieready.nl%{REQUEST_URI} [R=301,L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-YU+m4vQdZxI6LBKBwQ2BTEJQVIbcEVZl9xkNC0G5M/c=' 'sha256-SBzxHd6zr5pee7L9JI6e4vpeUkcH7rZZmvfdv6bVtGM=' 'sha256-nF2KOw+z27sFD21wCs1Bx6y1LA5KB4ebCbSTcXojCWk=' 'sha256-PlulwDmbt8XQ7hZihe9LwRRqwRfykhChqs0oqszRhsg=' 'sha256-3BRb/6Mrwyttan9V3CACprk6JP6Ams1yjUYh9n1dKr0=' 'sha256-mT8sOYguwd1OV1N3gU0Wj76GTC8uEuUrksox+GMLly8=' 'sha256-UELwwUUEeA4e98eDenH/Cx56Q5emDDMtvg/RCub/CeE=' 'sha256-im+8iKYTxkiuBIt4Om+iD7RJTKtijGkcDKoWsbHuCAU=' 'sha256-gnpD8UMnQbjC7RmfeWmTb86X2G+hPevI3WcV8eysZFo=' 'sha256-R6gZ0Vdgvb6Xj4Zp7CDu0wLdK0qi/HcIpU5lIyoZQDk=' 'sha256-Ms0jVaFfh8K4cA0y9uIJp4o2BPML3gA301zdD7nbL5U=' 'sha256-8ofSoIp96VKbjszyzJk6SSOj+RrAXj6/cKSkiA9DVEc=' 'sha256-EUIR5XxsUazvsCx8LjzE3PVlJnm5lKlbWvktxieUaFM=' 'sha256-FsjPKJgQHQIPxYA4Bga6jve/rYMPfnOBhL0ndVgEHxU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
<FilesMatch "\.(html|js|css)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Next-level test surfaces: never index before owner approval.
<IfModule mod_headers.c>
SetEnvIf Request_URI "^/(mijn-plan|advies|sales|bronbeheer)(/|$)" SRNextPrivate
Header always set X-Robots-Tag "noindex, nofollow" env=SRNextPrivate
</IfModule>
